<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="stairs_course">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>200</real_time_update_rate>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Six 0.16 m risers, a 1.4 m platform, then six descending risers.
         Start at the origin and drive in +X to test the full course. -->
    <model name="test_stairs">
      <static>true</static>
      <link name="stairs_link">
        <collision name="up_1_collision"><pose>2.175 0 0.08 0 0 0</pose><geometry><box><size>0.35 2.4 0.16</size></box></geometry></collision>
        <visual name="up_1_visual"><pose>2.175 0 0.08 0 0 0</pose><geometry><box><size>0.35 2.4 0.16</size></box></geometry><material><ambient>0.20 0.35 0.55 1</ambient><diffuse>0.20 0.35 0.55 1</diffuse></material></visual>
        <collision name="up_2_collision"><pose>2.525 0 0.16 0 0 0</pose><geometry><box><size>0.35 2.4 0.32</size></box></geometry></collision>
        <visual name="up_2_visual"><pose>2.525 0 0.16 0 0 0</pose><geometry><box><size>0.35 2.4 0.32</size></box></geometry><material><ambient>0.20 0.35 0.55 1</ambient><diffuse>0.20 0.35 0.55 1</diffuse></material></visual>
        <collision name="up_3_collision"><pose>2.875 0 0.24 0 0 0</pose><geometry><box><size>0.35 2.4 0.48</size></box></geometry></collision>
        <visual name="up_3_visual"><pose>2.875 0 0.24 0 0 0</pose><geometry><box><size>0.35 2.4 0.48</size></box></geometry><material><ambient>0.20 0.35 0.55 1</ambient><diffuse>0.20 0.35 0.55 1</diffuse></material></visual>
        <collision name="up_4_collision"><pose>3.225 0 0.32 0 0 0</pose><geometry><box><size>0.35 2.4 0.64</size></box></geometry></collision>
        <visual name="up_4_visual"><pose>3.225 0 0.32 0 0 0</pose><geometry><box><size>0.35 2.4 0.64</size></box></geometry><material><ambient>0.20 0.35 0.55 1</ambient><diffuse>0.20 0.35 0.55 1</diffuse></material></visual>
        <collision name="up_5_collision"><pose>3.575 0 0.40 0 0 0</pose><geometry><box><size>0.35 2.4 0.80</size></box></geometry></collision>
        <visual name="up_5_visual"><pose>3.575 0 0.40 0 0 0</pose><geometry><box><size>0.35 2.4 0.80</size></box></geometry><material><ambient>0.20 0.35 0.55 1</ambient><diffuse>0.20 0.35 0.55 1</diffuse></material></visual>
        <collision name="up_6_collision"><pose>3.925 0 0.48 0 0 0</pose><geometry><box><size>0.35 2.4 0.96</size></box></geometry></collision>
        <visual name="up_6_visual"><pose>3.925 0 0.48 0 0 0</pose><geometry><box><size>0.35 2.4 0.96</size></box></geometry><material><ambient>0.20 0.35 0.55 1</ambient><diffuse>0.20 0.35 0.55 1</diffuse></material></visual>
        <collision name="platform_collision"><pose>4.800 0 0.48 0 0 0</pose><geometry><box><size>1.40 2.4 0.96</size></box></geometry></collision>
        <visual name="platform_visual"><pose>4.800 0 0.48 0 0 0</pose><geometry><box><size>1.40 2.4 0.96</size></box></geometry><material><ambient>0.30 0.55 0.30 1</ambient><diffuse>0.30 0.55 0.30 1</diffuse></material></visual>
        <collision name="down_1_collision"><pose>5.675 0 0.48 0 0 0</pose><geometry><box><size>0.35 2.4 0.96</size></box></geometry></collision>
        <visual name="down_1_visual"><pose>5.675 0 0.48 0 0 0</pose><geometry><box><size>0.35 2.4 0.96</size></box></geometry><material><ambient>0.55 0.35 0.20 1</ambient><diffuse>0.55 0.35 0.20 1</diffuse></material></visual>
        <collision name="down_2_collision"><pose>6.025 0 0.40 0 0 0</pose><geometry><box><size>0.35 2.4 0.80</size></box></geometry></collision>
        <visual name="down_2_visual"><pose>6.025 0 0.40 0 0 0</pose><geometry><box><size>0.35 2.4 0.80</size></box></geometry><material><ambient>0.55 0.35 0.20 1</ambient><diffuse>0.55 0.35 0.20 1</diffuse></material></visual>
        <collision name="down_3_collision"><pose>6.375 0 0.32 0 0 0</pose><geometry><box><size>0.35 2.4 0.64</size></box></geometry></collision>
        <visual name="down_3_visual"><pose>6.375 0 0.32 0 0 0</pose><geometry><box><size>0.35 2.4 0.64</size></box></geometry><material><ambient>0.55 0.35 0.20 1</ambient><diffuse>0.55 0.35 0.20 1</diffuse></material></visual>
        <collision name="down_4_collision"><pose>6.725 0 0.24 0 0 0</pose><geometry><box><size>0.35 2.4 0.48</size></box></geometry></collision>
        <visual name="down_4_visual"><pose>6.725 0 0.24 0 0 0</pose><geometry><box><size>0.35 2.4 0.48</size></box></geometry><material><ambient>0.55 0.35 0.20 1</ambient><diffuse>0.55 0.35 0.20 1</diffuse></material></visual>
        <collision name="down_5_collision"><pose>7.075 0 0.16 0 0 0</pose><geometry><box><size>0.35 2.4 0.32</size></box></geometry></collision>
        <visual name="down_5_visual"><pose>7.075 0 0.16 0 0 0</pose><geometry><box><size>0.35 2.4 0.32</size></box></geometry><material><ambient>0.55 0.35 0.20 1</ambient><diffuse>0.55 0.35 0.20 1</diffuse></material></visual>
        <collision name="down_6_collision"><pose>7.425 0 0.08 0 0 0</pose><geometry><box><size>0.35 2.4 0.16</size></box></geometry></collision>
        <visual name="down_6_visual"><pose>7.425 0 0.08 0 0 0</pose><geometry><box><size>0.35 2.4 0.16</size></box></geometry><material><ambient>0.55 0.35 0.20 1</ambient><diffuse>0.55 0.35 0.20 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
