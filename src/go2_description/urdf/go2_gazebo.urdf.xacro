<?xml version='1.0' encoding='utf-8'?>
<!--
  Modified Unitree Go2 description (this file differs from the stock Unitree go2.urdf).

  Difference: every "*_calflower1" link carries one additional collision cylinder
  (length 0.034, radius 0.0115, origin xyz="-0.004 0 0.013", rpy="0 0 0"), which is
  parallel to the calflower1 axis and flush with its rear surface. It fills the
  wedge-shaped gap between calflower and calflower1 at the back of the lower leg,
  so the collision envelope is continuous across that junction instead of having a
  rear-side step/notch. The actuated joints also have 0.5 N m s/rad of
  physical damping to approximate the policy's velocity feedback without a
  delayed ROS round trip. The other inertias and collision shapes are unchanged.
-->
<robot name="go2" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <link name="base">
    <inertial>
      <origin xyz="0.021112 0 -0.005366" rpy="0 0 0" />
      <mass value="6.921" />
      <inertia ixx="0.02448" ixy="0.00012166" ixz="0.0014849" iyy="0.098077" iyz="-3.12E-05" izz="0.107" />
