  <!-- Initial joint positions are configured through the ros2_control state
       interfaces below. joint/initial_position is not a supported SDF element. -->

  <link name="imu">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.001" />
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <origin xyz="-0.02557 0 0.04232" rpy="0 0 0" />
    <parent link="base" />
    <child link="imu" />
    <axis xyz="0 0 0" />
  </joint>
  <link name="radar">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.001" />
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
    </inertial>
  </link>
  <joint name="radar_joint" type="fixed">
    <origin xyz="0.28945 0 -0.046825" rpy="0 2.8782 0" />
    <parent link="base" />
    <child link="radar" />
    <axis xyz="0 0 0" />
  </joint>
  <!-- Matches robot_gazebo Go2: the link is pitched down 30 degrees;
       the mesh has a separate 180-degree yaw correction. -->
  <joint name="mid360_joint" type="fixed">
    <parent link="base" />
    <child link="mid360_link" />
    <origin xyz="0.25 0 0.12" rpy="0 0.5235987755982988 0" />
  </joint>
  <link name="mid360_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 3.141592653589793" />
      <geometry><mesh filename="package://go2_description/meshes/mid360/mid360.dae" /></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0" />
      <geometry><cylinder radius="0.04" length="0.06" /></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0" />
      <mass value="0.265" />
      <inertia ixx="0.00020" ixy="0" ixz="0" iyy="0.00020" iyz="0" izz="0.00020" />
    </inertial>
  </link>

  <joint name="front_camera_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.32715 -0.00003 0.04297" />
      <parent link="base" />
      <child link="front_camera" />
  </joint>
  <link name="front_camera">
  </link>

  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find go2_description)/config/ros2_controllers.yaml</parameters>
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
    </plugin>
    <!-- The model origin is the base link origin. Publish full 3D world pose
         and body-frame velocity, with no added noise. -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <odom_frame>world</odom_frame>
      <robot_base_frame>base</robot_base_frame>
      <odom_publish_frequency>100</odom_publish_frequency>
      <odom_topic>/model/go2/odometry</odom_topic>
      <tf_topic>/model/go2/pose</tf_topic>
      <gaussian_noise>0</gaussian_noise>
    </plugin>
  </gazebo>

  <gazebo reference="base">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <topic>/go2/imu</topic>
      <imu/>
    </sensor>
  </gazebo>

  <!-- Approximate the Mid360 with a rotating 3D ray sensor. -->
  <gazebo reference="mid360_link">
    <sensor name="mid360" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>/go2/lidar</topic>
      <gz_frame_id>mid360_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159265</min_angle><max_angle>3.14159265</max_angle></horizontal>
          <vertical><samples>32</samples><resolution>1</resolution><min_angle>-0.122173</min_angle><max_angle>0.907571</max_angle></vertical>
        </scan>
        <range><min>0.3</min><max>30.0</max><resolution>0.02</resolution></range>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="FL_foot">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000</kp>
    <kd>1</kd>
    <sensor name="FL_foot_contact" type="contact">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>/go2/FL_foot_contact</topic>
      <contact>
        <collision>FL_foot_collision</collision>
      </contact>
    </sensor>
  </gazebo>
  <gazebo reference="FR_foot">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000</kp>
    <kd>1</kd>
    <sensor name="FR_foot_contact" type="contact">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>/go2/FR_foot_contact</topic>
      <contact>
        <collision>FR_foot_collision</collision>
      </contact>
    </sensor>
  </gazebo>
  <gazebo reference="RL_foot">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000</kp>
    <kd>1</kd>
    <sensor name="RL_foot_contact" type="contact">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>/go2/RL_foot_contact</topic>
      <contact>
        <collision>RL_foot_collision</collision>
      </contact>
    </sensor>
  </gazebo>
  <gazebo reference="RR_foot">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000</kp>
    <kd>1</kd>
    <sensor name="RR_foot_contact" type="contact">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
